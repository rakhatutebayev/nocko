      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "articleBlocks": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-article-block-6-blocks-section",
      "max": 6,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "articleCards": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-article-card-3-cards-section",
      "max": 3,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
