{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "IT services offered by NOCKO"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "service.service-hero-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "firstSection": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-content-block",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "serviceFeatures": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-feature",
      "max": 6,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondSection": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-content-block",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-benefit",
      "max": 6,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "resources": {
      "type": "component",
      "repeatable": true,
      "component": "service.service-resource",
      "max": 3,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "service.service-cta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
