    },
    "text": {
      "type": "text",
      "required": true
    },
    "link": {
      "type": "string"
    },
    "linkText": {
      "type": "string",
      "default": "Learn more"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "type": "string"
    }
  }
}
